# Configuração do backend. Copie para backend/.env e ajuste.
# Este arquivo NÃO carrega segredo — o .env real está no .gitignore.

# Postgres do docker-compose deste diretório. Porta 5433 porque a 5432 já é do
# stack do biahflow-portal-cliente.
DEVONADA_DATABASE_URL=postgresql+psycopg://devonada:devonada@localhost:5433/devonada

# --- Conta de usuário (M8, ADR 0012) -----------------------------------------
# Chave de assinatura do access token. Gere um valor longo e aleatório:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# SEM DEFAULT de propósito: um default publicado no repositório é uma chave que
# qualquer pessoa usa para forjar sessão. Vazia, toda rota autenticada responde
# 500 com frase útil — ruidoso, e é o ponto: falha silenciosa aqui seria falha
# aberta.
#
# TROCAR ESTA CHAVE DERRUBA TODAS AS SESSÕES ABERTAS. Os refresh continuam
# valendo (eles estão no banco, não são assinados), então o app se recupera
# sozinho na primeira renovação — mas o usuário pode ver um instante de login.
DEVONADA_JWT_SECRET=

# O tenant do beta. Tem UM uso: o primeiro cadastro feito num banco sem usuários
# o adota, para as dívidas e o caixa que já existem não ficarem órfãos.
DEVONADA_TENANT_ID=00000000-0000-0000-0000-000000000001

# Trava de força bruta no login.
DEVONADA_LOGIN_MAX_FALHAS=5
DEVONADA_LOGIN_BLOQUEIO_MINUTOS=15

# --- Envio de e-mail ---------------------------------------------------------
# Usado só pela recuperação de senha. `memoria` não envia nada e guarda numa
# lista — é o que a suíte usa, e serve para desenvolvimento local: o código sai
# no processo, e ninguém precisa de conta de SMTP para exercitar o fluxo.
# Valores: smtp | memoria
DEVONADA_CORREIO=smtp

# SEM SMTP CONFIGURADO NÃO HÁ RECUPERAÇÃO DE SENHA, e a rota continua
# respondendo 202 — ela responde 202 sempre, para não virar verificador de
# cadastro. Quem esquecer a senha fica sem caminho de volta. Ver a limitação
# declarada em docs/backend.md.
DEVONADA_SMTP_HOST=
DEVONADA_SMTP_PORT=587
DEVONADA_SMTP_USUARIO=
DEVONADA_SMTP_SENHA=
DEVONADA_SMTP_REMETENTE=

# Mínimo existencial, em CENTAVOS. Valor FIXO de R$ 600,00 — Decreto
# 11.150/2022, art. 3º, com a redação dada pelo Decreto 11.567, de 19/06/2023.
# NÃO é 25% do salário mínimo: essa era a redação original, substituída em 2023.
# Zero desliga o cálculo, e o app passa a exibir "ainda não calculado".
DEVONADA_MINIMO_EXISTENCIAL_CENTAVOS=60000

# Data da redação que fixou o valor acima. Aparece na tela junto do número.
DEVONADA_MINIMO_EXISTENCIAL_VIGENTE_EM=2023-06-19

# --- Revisão de cobrança (M6) ------------------------------------------------
# Tetos de juros do consignado, em BASIS POINTS ao mês. Definidos por resolução
# do CNPS, que os revê periodicamente. VAZIO É PROPOSITAL: sem o teto, a regra
# devolve None e o achado não existe — nunca um teto chutado (ADR 0008).
#
# CONFIRA NA FONTE OFICIAL ANTES DE PREENCHER. Na última checagem o valor
# corrente era 1,85% a.m. para empréstimo (1850) e 2,46% a.m. para cartão
# consignado e cartão de benefício (2460), aprovados pelo CNPS na 311ª reunião
# ordinária, de 25/03/2025 — mas NÃO foi possível confirmar isso em fonte
# oficial na época deste commit. Não copie daqui sem verificar.
DEVONADA_TETO_JUROS_CONSIGNADO_INSS_BPS=
DEVONADA_TETO_JUROS_CARTAO_CONSIGNADO_BPS=

# Data de vigência dos tetos acima (AAAA-MM-DD). Aparece na tela ao lado do
# achado que dependeu deles. Preencha junto com os tetos, sempre.
DEVONADA_TETOS_VIGENTES_EM=

# --- LLM ---------------------------------------------------------------------
# Provedor, uma escolha para o servidor inteiro. As capacidades (extração de
# contrato, assistente do chat) não sabem qual é. Ver docs/adr/0007.
# Valores: openai | anthropic
DEVONADA_LLM_PROVIDER=openai

# MODELO POR CAPACIDADE. Ler contrato exige visão, PDF e evidência literal por
# campo; classificar a intenção de uma frase, não. Um modelo só forçaria pagar
# o mais caro nas duas ou arriscar o mais fraco na leitura de contrato.
DEVONADA_LLM_MODEL_EXTRACAO=gpt-5
DEVONADA_LLM_MODEL_ASSISTENTE=gpt-5-mini

# Qual implementação de cada capacidade. `llm` usa o provedor acima;
# `determinista` responde sem modelo nenhum (é o que a suíte de testes usa).
DEVONADA_EXTRATOR=llm
DEVONADA_ASSISTENTE=llm

# Chave do provedor escolhido. SEM ELA, o recurso responde "falhou" com
# mensagem clara em vez de estourar — o app trata esse estado e oferece o
# caminho manual. Preencha só a do provedor que você usa.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --------------------------------------------------------------------------- #
# Assinatura (M9, ADR 0013)
# --------------------------------------------------------------------------- #

# Provedor de loja, no mesmo padrão plugável do LLM e do correio.
#   real    — fala com a App Store Server API e com o Google Play Developer API
#   memoria — confere um recibo que descreve a si mesmo (é o que a suíte usa)
DEVONADA_LOJA=real

# Dias de teste antes do paywall, contados da criação da conta.
#
# ESTE NÚMERO NÃO TEM FONTE A CITAR, e isso não é omissão: as constantes de
# backend/domain/ levam artigo de lei porque descrevem dinheiro que a lei define.
# Período de teste é escolha comercial, da mesma classe do preço.
DEVONADA_TESTE_DIAS=7

# Id do produto em cada loja. Precisa bater com o cadastrado na App Store
# Connect e no Play Console. O PREÇO não fica aqui — ele vem da loja, já
# localizado, e as duas exigem que seja assim.
DEVONADA_PRODUTO_ASSINATURA_IOS=br.com.devonada.app.mensal
DEVONADA_PRODUTO_ASSINATURA_ANDROID=br.com.devonada.app.mensal

# App Store Server API. A chave .p8 é gerada em Users and Access > Integrations
# > In-App Purchase, na App Store Connect. SEM DEFAULT de propósito: ausente
# significa "não configurado", e a rota de compra recusa com frase útil em vez
# de conferir o recibo contra o vazio e dizer a quem pagou que a compra não vale.
#
# A chave em UMA LINHA, com \n literal entre as partes — o adaptador desfaz.
DEVONADA_APPLE_KEY_ID=
DEVONADA_APPLE_ISSUER_ID=
DEVONADA_APPLE_BUNDLE_ID=br.com.devonada.app
DEVONADA_APPLE_KEY_P8=

# Google Play Developer API: o JSON da service account, em uma linha. A conta
# precisa da permissão "Ver dados financeiros" no Play Console.
DEVONADA_GOOGLE_SERVICE_ACCOUNT_JSON=
DEVONADA_GOOGLE_PACKAGE_NAME=br.com.devonada.app

# --------------------------------------------------------------------------- #
# Login social (M13, ADR 0023)
# --------------------------------------------------------------------------- #

# Provedor de identidade, no mesmo padrão plugável do LLM, do correio e da loja.
#   real    — confere o ID token contra a chave pública da Apple e do Google
#   memoria — confere um token que descreve a si mesmo (é o que a suíte usa)
DEVONADA_IDENTIDADE=real

# AUDIÊNCIAS ACEITAS no ID token, separadas por vírgula.
#
# VAZIO NÃO SIGNIFICA "aceita qualquer uma": significa recusar com 503 e a frase
# de não configurado. Assinatura válida só prova que o provedor emitiu o token
# para ALGUM app; é o `aud` que prova que foi para o nosso. Aceitar audiência
# qualquer entregaria a conta de qualquer usuário a quem controle outro app do
# mesmo provedor.
#
# Apple: o bundle id do app, mais o Services ID no dia do login pela web. NÃO cai
# de volta em DEVONADA_APPLE_BUNDLE_ID, que é da compra in-app: as duas são do
# mesmo app, e deixar uma valer pela outra é decidir por acidente.
DEVONADA_APPLE_CLIENT_IDS=

# Google: um client id por plataforma (iOS, Android e web), do Google Cloud
# Console. A biblioteca do app manda o webClientId como audiência do idToken nas
# DUAS plataformas, então o da web é o que quase nunca pode faltar.
DEVONADA_GOOGLE_CLIENT_IDS=
