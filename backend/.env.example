# Configuração do backend. Copie para backend/.env e ajuste.
# Este arquivo NÃO carrega segredo — o .env real está no .gitignore.

# Postgres do docker-compose deste diretório. Porta 5433 porque a 5432 já é do
# stack do biahflow-portal-cliente.
BUDDY_DATABASE_URL=postgresql+psycopg://buddy:buddy@localhost:5433/buddy

# Token de acesso do beta. Gere um valor longo e aleatório:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# O mesmo valor precisa chegar ao app. NÃO digite no celular — rode, na raiz:
#   npm run token:qr            (dev build / app instalado)
#   npm run token:qr -- --expo-go
# e leia o QR com a câmera do aparelho. Digitar à mão continua possível em
# Painel → Configurar conexão, mas são 43 caracteres.
BUDDY_API_TOKEN=

# Mínimo existencial, em CENTAVOS. Valor FIXO de R$ 600,00 — Decreto
# 11.150/2022, art. 3º, com a redação dada pelo Decreto 11.567, de 19/06/2023.
# NÃO é 25% do salário mínimo: essa era a redação original, substituída em 2023.
# Zero desliga o cálculo, e o app passa a exibir "ainda não calculado".
BUDDY_MINIMO_EXISTENCIAL_CENTAVOS=60000

# Data da redação que fixou o valor acima. Aparece na tela junto do número.
BUDDY_MINIMO_EXISTENCIAL_VIGENTE_EM=2023-06-19

# --- Revisão de cobrança (M6) ------------------------------------------------
# Tetos de juros do consignado, em BASIS POINTS ao mês. Definidos por resolução
# do CNPS, que os revê periodicamente. VAZIO É PROPOSITAL: sem o teto, a regra
# devolve None e o achado não existe — nunca um teto chutado (ADR 0008).
#
# CONFIRA NA FONTE OFICIAL ANTES DE PREENCHER. Na última checagem o valor
# corrente era 1,85% a.m. para empréstimo (1850) e 2,46% a.m. para cartão
# consignado e cartão de benefício (2460), aprovados pelo CNPS na 311ª reunião
# ordinária, de 25/03/2025 — mas NÃO foi possível confirmar isso em fonte
# oficial na época deste commit. Não copie daqui sem verificar.
BUDDY_TETO_JUROS_CONSIGNADO_INSS_BPS=
BUDDY_TETO_JUROS_CARTAO_CONSIGNADO_BPS=

# Data de vigência dos tetos acima (AAAA-MM-DD). Aparece na tela ao lado do
# achado que dependeu deles. Preencha junto com os tetos, sempre.
BUDDY_TETOS_VIGENTES_EM=

# --- LLM ---------------------------------------------------------------------
# Provedor, uma escolha para o servidor inteiro. As capacidades (extração de
# contrato, assistente do chat) não sabem qual é. Ver docs/adr/0007.
# Valores: openai | anthropic
BUDDY_LLM_PROVIDER=openai

# MODELO POR CAPACIDADE. Ler contrato exige visão, PDF e evidência literal por
# campo; classificar a intenção de uma frase, não. Um modelo só forçaria pagar
# o mais caro nas duas ou arriscar o mais fraco na leitura de contrato.
BUDDY_LLM_MODEL_EXTRACAO=gpt-5
BUDDY_LLM_MODEL_ASSISTENTE=gpt-5-mini

# Qual implementação de cada capacidade. `llm` usa o provedor acima;
# `determinista` responde sem modelo nenhum (é o que a suíte de testes usa).
BUDDY_EXTRATOR=llm
BUDDY_ASSISTENTE=llm

# Chave do provedor escolhido. SEM ELA, o recurso responde "falhou" com
# mensagem clara em vez de estourar — o app trata esse estado e oferece o
# caminho manual. Preencha só a do provedor que você usa.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
