# Configuração do backend. Copie para backend/.env e ajuste.
# Este arquivo NÃO carrega segredo — o .env real está no .gitignore.

# Postgres do docker-compose deste diretório. Porta 5433 porque a 5432 já é do
# stack do biahflow-portal-cliente.
BUDDY_DATABASE_URL=postgresql+psycopg://buddy:buddy@localhost:5433/buddy

# Token de acesso do beta. Gere um valor longo e aleatório:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# O mesmo valor vai no app, em Painel → Configurar conexão.
BUDDY_API_TOKEN=

# Salário mínimo vigente, em CENTAVOS. Base do mínimo existencial
# (Decreto 11.150/2022). Muda por lei todo ano — confira antes de usar.
BUDDY_SALARIO_MINIMO_CENTAVOS=151800

# Percentual do salário mínimo que compõe o mínimo existencial, em basis
# points. 2500 = 25%, conforme o Decreto 11.150/2022, art. 3º.
BUDDY_MINIMO_EXISTENCIAL_BPS=2500

# Leitura de contrato.
BUDDY_EXTRATOR=anthropic
BUDDY_LLM_MODEL=claude-opus-5

# Chave da Anthropic para a leitura de contrato. SEM ELA, o upload responde
# "falhou" com mensagem clara em vez de estourar — o app trata esse estado.
ANTHROPIC_API_KEY=
