{
  "expo": {
    "name": "Buddy Financeiro",
    "slug": "buddy-financeiro",
    "version": "0.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "buddyfinanceiro",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.buddyfinanceiro.buddy"
    },
    "android": {
      "package": "app.buddyfinanceiro.buddy",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": ["com.android.vending.BILLING"]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-asset",
      "expo-document-picker",
      "expo-iap",
      [
        "expo-image-picker",
        {
          "photosPermission": "Para ler o contrato a partir de uma imagem já salva no seu aparelho.",
          "cameraPermission": "Para fotografar o contrato e extrair os dados. A foto é lida e descartada — não guardamos o arquivo."
        }
      ]
    ]
  }
}
