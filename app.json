{
  "expo": {
    "name": "Buddy Financeiro",
    "slug": "buddy-financeiro",
    "version": "0.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "buddyfinanceiro",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-asset",
      "expo-document-picker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Para ler o contrato a partir de uma imagem já salva no seu aparelho.",
          "cameraPermission": "Para fotografar o contrato e extrair os dados. A foto é lida e descartada — não guardamos o arquivo."
        }
      ]
    ]
  }
}
