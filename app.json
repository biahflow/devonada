{
  "expo": {
    "name": "devo.nada",
    "slug": "devonada",
    "version": "0.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "devonada",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#101216"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.devonada.app"
    },
    "android": {
      "package": "br.com.devonada.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#101216"
      },
      "permissions": ["com.android.vending.BILLING"]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-asset",
      "expo-document-picker",
      "expo-iap",
      [
        "expo-image-picker",
        {
          "photosPermission": "Para ler o contrato a partir de uma imagem já salva no seu aparelho.",
          "cameraPermission": "Para fotografar o contrato e extrair os dados. A foto é lida e descartada — não guardamos o arquivo."
        }
      ]
    ]
  }
}
