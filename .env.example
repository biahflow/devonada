# Base URL da sua API FastAPI.
#
# Porta 8001, não 8000: a 8000 está ocupada pelo stack do
# biahflow-portal-cliente. Ver backend/docker-compose.yml.
#
# Em simulador, localhost funciona. Em aparelho físico com Expo Go, use o IP da
# sua máquina na rede local — localhost resolve para o próprio celular.
#   macOS: ipconfig getifaddr en0
#
# ATENÇÃO: tudo com prefixo EXPO_PUBLIC_ vai embutido no bundle e é público.
# Nunca coloque segredo aqui — os tokens de sessão vão para o SecureStore
# quando o usuário entra pelo login do app. Ver docs/guardrails.md, seção 2.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8001

# Id do produto de assinatura em cada loja (M9, ADR 0013).
#
# Precisa bater EXATAMENTE com o id cadastrado na App Store Connect e no Play
# Console — id errado faz a compra falhar na cara do usuário, com erro da loja.
#
# NÃO É SEGREDO: ele está impresso na página pública da assinatura na App Store,
# e o SDK precisa dele antes de qualquer chamada ao nosso servidor. Aqui o
# prefixo EXPO_PUBLIC_ é correto, não uma exceção.
#
# O PREÇO NÃO VEM DAQUI. Ele é lido da loja em tempo de execução, já localizado
# em moeda e formato — ver src/compras/.
EXPO_PUBLIC_PRODUTO_ASSINATURA_IOS=br.com.devonada.app.mensal
EXPO_PUBLIC_PRODUTO_ASSINATURA_ANDROID=br.com.devonada.app.mensal

# Client ids do Google Sign-In (M13, ADR 0023).
#
# NÃO É SEGREDO, pelo mesmo motivo do id do produto: client id de OAuth
# identifica o app, não autoriza nada sozinho — quem autoriza é o usuário, no
# fluxo do provedor. O client_secret do OAuth não existe em app nativo e não
# aparece em lugar nenhum deste repositório.
#
# O webClientId é o que vira audiência do idToken NAS DUAS PLATAFORMAS, e é ele
# que o servidor confere (DEVONADA_GOOGLE_CLIENT_IDS precisa contê-lo). Vazio
# desliga o botão do Google na tela de entrada.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# A APPLE NÃO TEM LINHA AQUI de propósito: o Sign in with Apple se identifica
# pelo bundle id, e quem sabe se ele está disponível é o próprio aparelho
# (isAvailableAsync). Uma variável seria uma segunda verdade sobre a mesma coisa.

# As duas páginas legais (F-018), exigidas pela App Store e pelo Google Play.
#
# O backend as serve em GET /termos e GET /privacidade — em desenvolvimento,
# aponte para o mesmo host da API. Em produção, aponte para o domínio público:
# um link de política de privacidade que dá 404 na frente do revisor da loja é
# reprovação.
#
# VAZIO DESLIGA O LINK e a linha legal da tela de entrada volta a ser texto
# simples, que é melhor que link quebrado.
EXPO_PUBLIC_URL_TERMOS=http://localhost:8001/termos
EXPO_PUBLIC_URL_PRIVACIDADE=http://localhost:8001/privacidade
