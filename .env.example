# Base URL da sua API FastAPI.
#
# Porta 8001, não 8000: a 8000 está ocupada pelo stack do
# biahflow-portal-cliente. Ver backend/docker-compose.yml.
#
# Em simulador, localhost funciona. Em aparelho físico com Expo Go, use o IP da
# sua máquina na rede local — localhost resolve para o próprio celular.
#   macOS: ipconfig getifaddr en0
#
# ATENÇÃO: tudo com prefixo EXPO_PUBLIC_ vai embutido no bundle e é público.
# Nunca coloque segredo aqui — o token de auth vai no SecureStore, pela tela
# Painel → Configurar conexão. Ver docs/guardrails.md, seção 2.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8001
